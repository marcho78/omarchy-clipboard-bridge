[Unit]
Description=Clipboard bridge to the macOS host (Parallels)
Documentation=https://github.com/marcho78/omarchy-clipboard-bridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/clipboard-bridge connect
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
