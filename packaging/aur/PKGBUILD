# Maintainer: marcho78
pkgname=omarchy-clipboard-bridge
pkgver=0.2.0
pkgrel=1
pkgdesc="Shared clipboard between an Omarchy (Hyprland) VM and its macOS host under Parallels Desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/marcho78/omarchy-clipboard-bridge"
license=('MIT')
depends=('wl-clipboard')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/clipboard-bridge "$pkgdir/usr/bin/clipboard-bridge"
  ln -s clipboard-bridge "$pkgdir/usr/bin/omarchy-clipboard-bridge"
  install -Dm644 packaging/aur/clipboard-bridge.service "$pkgdir/usr/lib/systemd/user/clipboard-bridge.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
